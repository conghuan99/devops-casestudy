{
  "title": "Flask App Dashboard",
  "uid": "flask-app-dashboard",
  "timezone": "browser",
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": {"x":0,"y":0,"w":12,"h":8},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [
        {
          "expr": "sum by (method, status) (rate(flask_http_request_total[1m]))",
          "legendFormat": "{{method}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit":"reqps"}
      }
    },
    {
      "id": 2,
      "title": "Latency p95 (seconds)",
      "type": "timeseries",
      "gridPos": {"x":12,"y":0,"w":12,"h":8},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(flask_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{path}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit":"s"}
      }
    },
    {
      "id": 3,
      "title": "HTTP Status Breakdown",
      "type": "timeseries",
      "gridPos": {"x":0,"y":8,"w":12,"h":8},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "targets": [
        {
          "expr": "sum by (status) (rate(flask_http_request_total[1m]))",
          "legendFormat": "status {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit":"reqps"}
      }
    },
    {
      "id": 4,
      "title": "App Logs",
      "type": "logs",
      "gridPos": {"x":12,"y":8,"w":12,"h":8},
      "datasource": {"type":"loki","uid":"loki"},
      "targets": [
        {
          "expr": "{pod=~\"flask-app-deployment-.*\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
